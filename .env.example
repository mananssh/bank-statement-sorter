# Copy to .env.local and adjust.

# Where the SQLite database, session secret, and backups live.
# Defaults to <project>/data when unset. Point it somewhere covered by your backups.
# DATA_DIR=C:\path\to\your\finance\app-data

# Document archive root (imported statements get filed here) and inbox folder.
# Both default to subfolders of DATA_DIR's parent when unset; configurable in Settings too.
# ARCHIVE_ROOT=C:\path\to\your\finance\archive
# INBOX_DIR=C:\path\to\your\finance\inbox

# Privacy: disable Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
